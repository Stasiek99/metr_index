{
  "name": "@metr-index/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "etl:nbp:download": "tsx src/etl/nbp/download.ts",
    "etl:nbp:seed": "tsx src/etl/nbp/seed.ts",
    "etl:rcn:seed": "tsx src/etl/rcn/seed.ts",
    "etl:gus:seed": "tsx src/etl/gus/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@metr-index/shared": "^0.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
